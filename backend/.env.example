# ==============================================================
# Vardha Builders - Backend Environment Configuration Example
# ==============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with sensitive credentials to Git.

# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local mongod)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vardha_builders?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vardha_builders

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# JWT Secret for Authenticated Admin Endpoints (Generate a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Node Environment ('development' | 'production')
NODE_ENV=development
