# ==============================================================
# Vardha Builders - Frontend Environment Configuration Example
# ==============================================================
# Copy this file to .env or .env.local for local overrides.

# Backend API Base URL (including /api prefix)
# Local development default:
VITE_API_URL=http://localhost:5000/api
# Production deployment example:
# VITE_API_URL=https://api.vardhabuilders.com/api

# Official Business WhatsApp Number (with country code, no + or spaces)
# Example for India (+91 9999999999): 919999999999
VITE_WHATSAPP_NUMBER=919999999999
